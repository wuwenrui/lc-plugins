{
  "version": 1,
  "plugins": [
    {
      "id": "lawyer-memos",
      "name": "律师备忘录",
      "description": "对话内可用的备忘录：AI 可帮你列出、创建、完成备忘；设置页提供管理界面，数据保存在本机。",
      "version": "0.2.0",
      "tier": "js",
      "minAppVersion": "1.0.5",
      "sdkVersion": "^0.4",
      "permissions": [
        "storage",
        "tools",
        "ui:settings-section",
        "exec:osascript"
      ],
      "files": {
        "manifest.json": "c9ce39b360126178ff5636d0c87070b0439c5aff41a4aaa41668795c40909e66",
        "main.js": "da16a47e7abe9b60f5ad4c126e9dd2c892db08cf86f18aac6185046dcd4c8b47"
      },
      "notes": "首个 AI 可用插件能力试点。"
    },
    {
      "id": "lawyer-calendar",
      "name": "律师日历",
      "description": "基于 macOS 日历.app 的日程助手：AI 可查未来日程、起草日程草稿，律师确认后才写入真实日历（自动带 15 分钟前提醒）。",
      "version": "0.1.0",
      "tier": "js",
      "minAppVersion": "1.0.5",
      "sdkVersion": "^0.4",
      "permissions": [
        "storage",
        "tools",
        "ui:settings-section",
        "exec:osascript",
        "exec:open"
      ],
      "files": {
        "manifest.json": "5c60e45d031abefaec028fef4a9e35edd911a25687b64e219f42d9ef32244c28",
        "main.js": "08c13369fffaac806fe0a0b2a5dd2090a58cd980bf96bb9b356756ece6ed98fc"
      },
      "notes": "首个接入本机系统应用（日历.app）的插件；写路径为 起草 → 律师确认入历。"
    },
    {
      "id": "lawyer-mail",
      "name": "律师邮件",
      "description": "AI 可真实收发邮件（IMAP/SMTP）：搜索、读信、发信（必须律师确认）、写入输入框草稿；设置页绑定邮箱。",
      "version": "0.1.0",
      "tier": "js",
      "minAppVersion": "1.0.5",
      "sdkVersion": "^0.4",
      "permissions": [
        "storage",
        "tools",
        "ui:settings-section",
        "composer:draft",
        "exec:node"
      ],
      "files": {
        "manifest.json": "3d4596f6c76af17481cdd1163faca73b73dc5712697388af6b355eae81a96f07",
        "main.js": "bbc2350946102000e6ecbb578df2a826939a05ef56c5b896c5aa12f1963565c4",
        "errors.js": "922efc20d94ccc2cc58ecc10b4099ddf1788a6c7e4af38c34ad747636afc4549",
        "imap.js": "c1ae92365ffbf19007f438e9ace0b9a72541791c116ff67113b685d7ddc10919",
        "mime-word.js": "91ecb381bc9efd1e6b8e919dc53cc1cc47cf55411a990c453fd8266a7ffee1e6",
        "mime.js": "d2033256f5079261cfe3cfcc134a4f2caea30f01d57cdc43685a094b835b8cbf",
        "server.mjs": "19c3f51faf08be3b7dc752c7a5c6c94b2175c79d4f58a75c5fb9b8df4b6e1e80",
        "smtp.js": "38e2a3d6e016437e159a2ae52bc6938a6ec1a100e1aa059e6180d8223135697c",
        "validate.js": "b050ec7b24a8cce3acf0ada1fca37bd052c7c01eabddbf6cd3838b06a6816c4c"
      },
      "notes": "首个双进程形态插件：协议层跑在 dist-server/server.mjs（自 LawyerDesk lawyer-harness 移植的零依赖 IMAP/SMTP 实现）。发布前需扩展 publish.mjs 逐文件收录 dist-server/*。"
    },
    {
      "id": "lawyer-billing",
      "name": "模型站计费",
      "description": "在设置页与状态栏查看模型站余额和用量；对话里可直接问 AI 剩余额度、近期消费。",
      "version": "0.1.0",
      "tier": "js",
      "minAppVersion": "1.0.5",
      "sdkVersion": "^0.4",
      "permissions": [
        "storage",
        "tools",
        "ui:settings-section",
        "ui:status-bar",
        "network:model.codingrui.work"
      ],
      "files": {
        "manifest.json": "1e0a792e57430c66449e8012200cc2db332d67ec94650bf62ab04fd75ce65b40",
        "main.js": "795066385e6837eb81332638981d89285af199c9be339ec5d7829f996a1ea7c5"
      },
      "notes": "首次使用请在设置页粘贴模型站 API 令牌。"
    },
    {
      "id": "lawyer-qcc",
      "name": "企查查",
      "description": "连接企查查账号后，AI 可查询企业工商、风险、知识产权等信息。",
      "version": "0.1.0",
      "tier": "js",
      "minAppVersion": "1.0.5",
      "sdkVersion": "^0.4",
      "permissions": [
        "storage",
        "tools",
        "ui:settings-section",
        "events",
        "network:agent.qcc.com",
        "network:127.0.0.1",
        "exec:sh"
      ],
      "files": {
        "manifest.json": "ba53d022ba876af1b3684524191df89550b779948bbc18e99d203ab6329134f5",
        "main.js": "dfd1d3712f8b32b509495d0af146e81ca800b9f2592ad70c8fa0f6257146c396"
      },
      "notes": "首次使用请在设置页点击「连接企查查」完成授权。"
    }
  ]
}
