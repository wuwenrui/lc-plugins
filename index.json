      "version": "0.3.0",
      "tier": "js",
      "minAppVersion": "1.0.5",
      "sdkVersion": "^0.4",
      "permissions": [
        "storage",
        "tools",
        "ui:settings-section",
        "ui:panel-tab",
        "exec:osascript"
      ],
