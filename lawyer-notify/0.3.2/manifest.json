{
  "id": "lawyer-notify",
  "name": "任务提醒",
  "version": "0.3.2",
  "tier": "js",
  "sdkVersion": "^0.4",
  "minAppVersion": "1.0.6",
  "permissions": [
    "storage",
    "events",
    "ui:settings-section",
    "ui:status-bar",
    "exec:osascript"
